PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=irc
DB_USER=root
DB_PASSWORD=
DB_SSL=false
JWT_SECRET=
JWT_EXPIRES_IN=2h
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the server (1 on Render/Railway). Leave empty for local development
# or when the server is exposed directly. Never "true".
TRUST_PROXY=
# Optional rate-limit tuning (failed logins per 15 minutes): per IP address and per roll number.
# LOGIN_IP_LIMIT=100
# LOGIN_ACCOUNT_LIMIT=10
# Development only: must be true to run `npm run seed` (demo users with known passwords). Never in production.
ALLOW_DEMO_DATA=false
